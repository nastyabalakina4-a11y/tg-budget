# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# HTTPS-адрес, по которому открывается Mini App (Telegram требует HTTPS)
WEBAPP_URL=https://money.example.com/

# Telegram ID двух участников через запятую.
# Узнать свой ID: запустите бота и нажмите /start — он ответит вашим ID.
ALLOWED_USER_IDS=111111111,222222222

# Валюта для отображения
CURRENCY=RSD

# Где хранить базу (внутри контейнера это /app/data, папка проброшена наружу)
DB_PATH=data/budget.db

HOST=0.0.0.0
PORT=8080
TZ=Europe/Belgrade
